# 阶段 1：S3 单板 BLE 透传（BT 控制器 HCI ⇄ USB CDC）
CONFIG_IDF_TARGET="esp32s3"

# 日志走 UART0（GPIO43/44，即串口桥 USB 口）。
# 不能用 USB 控制台：USB-Serial/JTAG 与 TinyUSB 的 USB-OTG 共用同一 USB PHY，
# TinyUSB 起来后 Serial/JTAG 就没了，日志也就没了。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# 蓝牙：仅控制器（无主机栈），BLE-only
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
# 控制器走"外部 HCI 传输层"模式（官方例程同款配置）。
# 传输本体由固件里的 hci_tl_usb.c 提供 callbacks 指到 USB CDC。
CONFIG_BT_CTRL_HCI_MODE_UART_H4=y
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n

# TinyUSB CDC：CDC0 = HCI 数据口，CDC1 = 控制台（boot/dfu/stats）
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
# HCI 包最大约 512 字节，收发缓冲对齐到 512
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
