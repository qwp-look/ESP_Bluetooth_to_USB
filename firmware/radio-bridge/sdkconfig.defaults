# 阶段 3：经典 ESP32 双模控制器，HCI H:4 经 UART2 输出
# 接线见 docs/hardware-wiring.md：TX2=GPIO17 → S3 RX(GPIO18)，RX2=GPIO16 ← S3 TX(GPIO17)
CONFIG_IDF_TARGET="esp32"

# 蓝牙：仅控制器（无主机栈），双模（BLE + 经典蓝牙）
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BTDM=y

# 控制器自带 UART H4 模式：控制器直接驱动 UART2 收发 HCI 包
CONFIG_BTDM_CTRL_HCI_MODE_UART_H4=y
CONFIG_BTDM_CTRL_HCI_UART_NO=2
CONFIG_BTDM_CTRL_HCI_UART_BAUDRATE=921600
# 硬件流控：默认是开的（Kconfig bool default y），必须显式关掉——
# RTS/CTS 两根线没接（GPIO4/13 预留），开着会导致控制器 UART 行为异常
CONFIG_BTDM_CTRL_HCI_UART_FLOW_CTRL_EN=n

# 控制器性能参数（沿用官方例程默认：9 BLE 连接 / 7 ACL / 3 同步连接）
CONFIG_BTDM_CTRL_BLE_MAX_CONN=9
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=7
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=3
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
